<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.uds.consent</groupId>
    <artifactId>uds-consent-platform</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>consent-service</artifactId>
  <name>Consent Control Plane Service</name>
  <description>
    The deployable application: consent ingestion API, decision API, snapshot issuance, admin
    registries, suppression, rights and receipts.
  </description>

  <dependencies>
    <dependency>
      <groupId>com.uds.consent</groupId>
      <artifactId>consent-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.uds.consent</groupId>
      <artifactId>consent-ledger</artifactId>
    </dependency>
    <dependency>
      <groupId>com.uds.consent</groupId>
      <artifactId>consent-policy</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <!-- Bearer tokens from the group's OIDC provider, alongside the HTTP Basic credentials rather
         than instead of them. Version managed by spring-boot-dependencies: pinning it here is how
         a Spring Security skew gets introduced between the resource server and the starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <!-- Scrape endpoint for the meters PlatformMetrics already registers. Boot manages the
         version; the 1.12.6 that was cached locally is the obsolete simpleclient generation that
         Boot 3.5 dropped auto-configuration for, so pinning would produce a 404 at /prometheus
         and no explanation of it. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>

    <!-- Tracing, off unless an OTLP endpoint is configured. See application.yml: an exporter
         retrying into a void on every span is CPU spent to produce nothing. -->
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-tracing-bridge-otel</artifactId>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-exporter-otlp</artifactId>
    </dependency>

    <!-- Fan-out to downstream systems. The producer connects lazily, so a deployment that
         leaves uds.consent.events.publisher at its default never reaches a broker. -->
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka</artifactId>
    </dependency>

    <!-- Testcontainers spins up a real PostgreSQL. The ledger's append-only guarantee is a
         database guarantee, so proving it against an in-memory substitute would prove nothing. -->
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
