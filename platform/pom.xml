<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>

  <groupId>com.uds.consent</groupId>
  <artifactId>uds-consent-platform</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>UDS Consent &amp; Privacy Control Plane</name>
  <description>
    Group-wide consent, notice and enforcement platform for UDS Group entities acting as
    Data Fiduciaries under the DPDP Act 2023 / DPDP Rules 2025, TRAI TCCCPR 2018,
    GDPR/UK GDPR, Korea PIPA, Singapore PDPA and Malaysia PDPA.
  </description>

  <modules>
    <module>consent-core</module>
    <module>consent-ledger</module>
    <module>consent-policy</module>
    <module>consent-service</module>
  </modules>

  <properties>
    <!-- Suites excluded from `mvn verify`. See the failsafe plugin's comment below. -->
    <failsafe.excluded.groups>keycloak</failsafe.excluded.groups>
    <java.version>21</java.version>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.8.17</springdoc.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.uds.consent</groupId>
        <artifactId>consent-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.uds.consent</groupId>
        <artifactId>consent-ledger</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.uds.consent</groupId>
        <artifactId>consent-policy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <excludedGroups>integration</excludedGroups>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>

    <plugins>
      <!-- Integration tests run under failsafe, on `mvn verify`, and need Docker for the
           Testcontainers PostgreSQL. Split from the unit suite so that `mvn test` stays fast
           enough to run on every save; the append-only guarantee is a database guarantee and
           cannot be checked without a database. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <groups>integration</groups>
          <!-- KeycloakIssuerIT carries this tag and not `integration`… except that JUnit 5
               inherits class-level tags from a superclass, and it extends
               PostgresIntegrationTest for the database. So the tag alone would not exclude it
               and it is excluded here instead. It pulls a ~450 MB image and starts a JVM inside
               it to test an identity provider rather than this platform; JwtAuthenticationIT's
               javadoc already refused that trade for every build. Run it deliberately:

                 mvn -B verify -pl consent-service -am -Dit.test=KeycloakIssuerIT \
                     -Dfailsafe.excluded.groups=

               It therefore contributes nothing to .claude/state/test-baseline, which is the
               honest reading and not an oversight. -->
          <excludedGroups>${failsafe.excluded.groups}</excludedGroups>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
