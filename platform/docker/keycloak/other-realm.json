{
  "realm": "other",
  "enabled": true,
  "displayName": "A deliberately foreign issuer",
  "sslRequired": "none",
  "accessTokenLifespan": 600,
  "clients": [
    {
      "clientId": "other-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "uds-consent-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "uds-consent-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "outsider",
      "enabled": true,
      "firstName": "Out",
      "lastName": "Sider",
      "email": "outsider@elsewhere.example",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ]
    }
  ]
}
