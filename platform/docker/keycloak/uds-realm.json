        "entity.DENAVE_IN"
      ],
      "requiredActions": []
    },
    {
      "username": "over.assigned",
      "enabled": true,
      "email": "over.assigned@uds.example",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "entity.MATRIX",
        "entity.DENAVE_IN"
      ],
      "firstName": "Over",
      "lastName": "Assigned",
      "requiredActions": []
    }
  ]
}
