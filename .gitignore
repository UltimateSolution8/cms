# Build output
target/
*.class
*.jar
*.war

# Secrets and local overrides. Nothing in this repository should ever carry a real
# identifier pepper, signing key or client credential — those come from the KMS.
.env
.env.*
*.pem
*.p8
application-local-secrets.yml

# Local database dumps. A dump of this schema is a dump of regulated personal data.
*.sql.gz
*.dump
dumps/

# Session tooling. The shared configuration under .claude/ — the working notes, the invariants, the
# subagent roles, the phase gate — is tracked deliberately: it is the practice that produced this
# repository and the next session needs it. Only the per-machine parts are ignored.
.claude/settings.local.json
.claude/state/last-verify

# Tooling
.DS_Store
.idea/
*.iml
.vscode/
.mvn/wrapper/maven-wrapper.jar
