# Template. Copy to .env, fill in, and never commit the result — .gitignore in this directory
# refuses it, and that refusal is the point rather than a formality.
#
#   cp .env.example .env && $EDITOR .env
#   set -a && . ./.env && set +a
#
# ---------------------------------------------------------------------------------------------
# ROTATE THE DATABASE PASSWORD BEFORE THIS ENVIRONMENT CARRIES ANYTHING REAL.
#
# The password this project was first provisioned with arrived in a chat message. It is therefore
# already disclosed, to a transcript nobody controls, and no amount of care with this file changes
# that. Rotate it in the Supabase dashboard (Settings → Database → Reset password), then re-run
# deploy/hosted/verify.sql to confirm both roles still connect. Treat this as done when somebody
# has done it, not when somebody has read this paragraph.
# ---------------------------------------------------------------------------------------------

# The pooler host, session mode, port 5432. Not 6543 — see the `hosted` profile in
# application.yml for why, and for why testing 6543 with one connection will not show you.
DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres

# On the pooler the username carries the project reference: <role>.<project-ref>.
DB_USER=uds_consent_app.<project-ref>
DB_PASSWORD=

# Migrations connect as the owner. This MUST be a different role from DB_USER: V2 revokes UPDATE
# and DELETE on the evidence tables from the application role, and if the two were the same role
# the migration could not run at all — and the application would hold the ability to edit history.
# On Supabase the owner is `postgres`, which also holds BYPASSRLS, so nothing but Flyway may ever
# connect with these.
DB_MIGRATION_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres
DB_MIGRATION_USER=postgres.<project-ref>
DB_MIGRATION_PASSWORD=

# 32 bytes minimum. Outside the `local` profile a short or absent pepper is a hard start-up
# failure, not a warning: every identifier hash in the system silently degrades without it, and a
# degraded hash is not visible in any output.
IDENTIFIER_PEPPER=

# Ed25519 private key for offline decision snapshots, base64. SigningKeyProvider is the seam a KMS
# implements; until there is one, this is an environment variable and its custody is UDS's
# decision — REGULATORY_HANDOFF.md §8.
SNAPSHOT_SIGNING_KEY=

# Bearer tokens. Leave unset and the resource server is not registered at all, which is the
# state that made the first Entra token look like a platform failure: with no issuer configured
# the Authorization header is never parsed and Basic answers 401.
OIDC_ISSUER_URI=
OIDC_AUDIENCE=

# Exact origins for the console and the principal portal. Empty means no browser client can call
# this deployment at all. A wildcard is refused at start-up rather than accepted quietly.
CORS_ALLOWED_ORIGINS=
